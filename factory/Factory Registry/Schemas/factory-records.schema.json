{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solvys.io/schemas/factory-records.schema.json",
  "title": "Solvys Factory Record",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "sprintId": { "type": "string", "pattern": "^S[0-9]{3,}$" },
    "specMaturity": {
      "enum": ["micro", "spec-first", "spec-anchored", "spec-as-source"]
    },
    "developmentContract": {
      "type": "object",
      "required": [
        "path",
        "maturity",
        "revision",
        "status",
        "implementationAuthorized"
      ],
      "properties": {
        "path": { "type": ["string", "null"] },
        "maturity": {
          "type": ["string", "null"],
          "enum": [null, "micro", "spec-first", "spec-anchored", "spec-as-source"]
        },
        "revision": { "type": ["integer", "null"], "minimum": 1 },
        "status": {
          "type": ["string", "null"],
          "enum": [null, "draft", "approved", "implemented", "verified"]
        },
        "validatedAt": { "type": ["string", "null"] },
        "validatorReceipt": { "type": ["string", "null"] },
        "implementationAuthorized": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "planned",
        "approved",
        "installed",
        "configured",
        "wired",
        "tested",
        "provider-verified",
        "deployed",
        "human-accepted",
        "failed",
        "stale",
        "paused-for-factory-cutover"
      ]
    }
  },
  "additionalProperties": true
}
