      "password": "40000000-0000-4000-8000-000000000002",
      "totp": "40000000-0000-4000-8000-000000000003"
    },
    "accessTokenEnv": "BWS_ACCESS_TOKEN"
  },
  "bw": {
    "itemId": "40000000-0000-4000-8000-000000000004",
