    "https://login.example.com"
  ],
  "clipboard": {
    "enabled": true,
    "ttlSeconds": 30,
    "allowedCredentials": [
      "primary"
    ]
  },
  "bws": {
    "projectId": "40000000-0000-4000-8000-000000000000",
    "secretIds": {
