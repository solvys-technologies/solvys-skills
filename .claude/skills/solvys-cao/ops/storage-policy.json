{
  "version": 2,
  "effectiveDate": "2026-07-29",
  "timezone": "America/New_York",
  "inventorySurface": "current_codex_task_only",
  "observationModeThrough": "2026-08-01T23:59:59-04:00",
  "actionModeStarts": "2026-08-02T00:00:00-04:00",
  "internalThresholds": {
    "healthyMinFreeBytes": 40000000000,
    "healthyMinFreePercent": 15,
    "yellowBelowFreeBytes": 40000000000,
    "yellowBelowFreePercent": 15,
    "redBelowFreeBytes": 20000000000,
    "redBelowFreePercent": 10,
    "criticalBelowFreeBytes": 10000000000,
    "criticalBelowFreePercent": 5
  },
  "externalMinFreePercent": 20,
  "conversationSweepDays": 10,
  "transcriptInactivityDays": 30,
  "cacheMinimumAgeDays": 30,
  "workspaceRoots": {
    "codebases": "/Volumes/Ext./Codebases",
    "managedWorktrees": "/Volumes/Ext./CodexWorktrees/managed",
    "explicitWorktrees": "/Volumes/Ext./CodexWorktrees",
    "storageOps": "/Volumes/Ext./SolvysOps/storage",
    "runtimeBundles": "~/Library/Application Support/{Product}/runtime",
    "runtimeLogs": "~/Library/Logs/{Product}"
  },
  "executionLanes": {
    "defaultImplementation": "cloud_task_owned_worktree",
    "nonFlagshipImplementation": "cloud",
    "fintheonFlagship": "external_local_source_custody",
    "fintheonBackendCompute": "cloud_when_exact_ref_and_turnkey_brief_are_pushed",
    "localExceptions": [
      "planning_executive_marketing",
      "dirty_super_sprint_custody",
      "wonder_or_source_transfer",
      "port_7777_or_named_sandbox_proof",
      "mac_or_hardware_behavior",
      "deployment_review",
      "installed_app_verification"
    ],
    "internalLocal": "exception_only_when_healthy_and_bounded"
  },
  "branchAndRefContract": {
    "mainProtected": true,
    "humanIntegrationBranchPattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "taskCheckpointRefPattern": "^refs/sprints/S\\d{3,}(?:/T[1-9]\\d*)?/P\\d+$",
    "forceRewriteAcceptedHistory": false,
    "dailyPrMergeMethod": "squash",
    "deleteDateBranchRequiresAuthorization": true
  },
  "backupContract": {
    "encryptedLocalManifestRequired": true,
    "encryptedCloudManifestRequired": true,
    "restoreReadbackRequired": true,
    "uploadedIsComplete": false,
    "personalUniqueStateReadbackBeforeDestructiveReconstruction": true,
    "restoreDrillTarget": "bounded_non_production"
  },
  "resourceBudgets": {
    "requiredCategories": [
      "tasks",
      "worktrees",
      "checkpoints",
      "artifacts",
      "transcripts",
      "dmgs",
      "processes",
      "ram"
    ],
    "blockNewWorkOnBreach": true,
    "defaultCeilings": {
      "concurrentLocalImplementationTasks": 1,
      "taskOwnedProcessesPerTask": {
        "preview": 1,
        "browser": 1,
        "server": 2,
        "total": 4
      },
      "peakRamPercent": 75,
      "sustainedRamPercent": 65,
      "sustainedRamMinutes": 5,
      "dmgsPerProductSprint": 1,
      "dmgLifetimeHoursAfterVerification": 24,
      "artifactBytesPerTask": 2000000000,
      "artifactBytesPerSprint": 10000000000,
      "checkpointsPerTrack": 3,
      "checkpointsPerSprint": 12,
      "worktreesPerTrack": 1,
      "worktreesPerSprint": 4,
      "activeTranscriptsPerTask": 1
    },
    "overrideRequiredFields": [
      "reason",
      "owner",
      "approver",
      "startsAt",
      "endsAt",
      "replacementCeiling",
      "cleanupReturnCondition"
    ],
    "breachActions": [
      "stop_new_launches",
      "inventory_exact_task_owned_resources",
      "gracefully_stop_task_owned_processes_oldest_first",
      "verify_pid_exit",
      "archive_finished_tasks_and_transcripts_through_owner",
      "retain_current_and_rollback_checkpoints",
      "mark_superseded_refs_for_control_plane_retention",
      "use_recoverable_cleanup_for_verified_expired_dmgs_and_reproducible_artifacts",
      "resume_only_below_ceiling_or_with_active_recorded_override"
    ],
    "neverKillUnrelatedOrSystemProcesses": true,
    "openedWorktreeRemovalOwner": "task_archival_and_codex_managed_retention"
  },
  "secretManifest": {
    "valuesAllowed": false,
    "namesOnly": true,
    "excludedClassesWithoutExactAuthority": [
      "production",
      "unrelated_client",
      "personal",
      "signing",
      "machine_wide"
    ]
  },
  "riskContract": {
    "blacksmithRequires": [
      "deterministic",
      "bounded",
      "reversible",
      "exact_tested_rollback",
      "bounded_tests",
      "no_protected_surface"
    ],
    "routineAcceptedBackend": {
      "squashThroughDatePullRequest": true,
      "deployWhenRequiredCiIsGreen": true,
      "separateHumanMergeOrDeployAuthorization": false
    },
    "humanVerificationBeforeMergeOrDeploy": [
      "migrations",
      "destructive_writes",
      "authentication",
      "authorization",
      "billing",
      "secrets_or_provider_credentials",
      "infrastructure",
      "broad_routing",
      "security_controls",
      "irreversible_integrations",
      "release_or_install_behavior",
      "protected_surface_changes"
    ]
  },
  "approvedActions": {
    "inventory": true,
    "conversationCandidateReport": true,
    "automationTargetProtection": true,
    "cacheSanitationAfterObservation": true,
    "externalArchiveSanitationAfterObservation": true,
    "transcriptColdStoragePilot": true,
    "manualWorktreeDeletion": false,
    "codexHomeMigration": false
  },
  "sanitationRules": {
    "registeredTaskTemp": {
      "enabledAfterObservation": true,
      "rootSource": "tranche-registry.entries[].sanitationPaths",
      "minimumAgeDays": 30,
      "requirements": [
        "exact path is registered",
        "owning tranche is archive-eligible",
        "no active process or task reference",
        "regular files only",
        "post-delete absence check"
      ]
    },
    "externalQuarantine": {
      "enabledAfterObservation": true,
      "root": "/Volumes/Ext./SolvysOps/storage/quarantine",
      "minimumAgeDays": 30,
      "requirements": [
        "entry is not marked partial or authoritative rollback",
        "source and destination checksums or Git identity are recorded",
        "no active process, task, tranche, automation, or legal reference",
        "exact candidate is reported before action",
        "post-delete absence and free-space checks"
      ]
    },
    "transcriptArchive": {
      "enabledAfterObservation": true,
      "root": "/Volumes/Ext./SolvysOps/storage/transcript-archive",
      "minimumArchiveAgeDays": 90,
      "requirements": [
        "thirty-day source inactivity and non-reference gate previously passed",
        "archive manifest and SHA-256 exist",
        "decompression and readback proof passed",
        "no active task, automation, goal, legal, client, or memory reference",
        "exact candidate is reported before action",
        "post-delete absence and free-space checks"
      ]
    },
    "generatedImages": {
      "enabledAfterObservation": false,
      "root": "~/.codex/generated_images",
      "mode": "candidate-report-only",
      "reason": "No durable mapping currently proves which assets have been exported or remain task-referenced."
    }
  },
  "hardDenyRoots": [
    "~/.codex/sessions",
    "~/.codex/archived_sessions",
    "~/.codex/memories",
    "~/.codex/skills",
    "~/.codex/auth.json",
    "~/.codex/*.sqlite*",
    "~/Library/Application Support",
    "~/Library/Keychains",
    "/System",
    "/private/var/vm"
  ],
  "taskLifecycle": {
    "flushTrigger": "flush memory",
    "memoryNotesMax": 1,
    "archiveSelfAfterVerifiedFlush": true
  }
}
